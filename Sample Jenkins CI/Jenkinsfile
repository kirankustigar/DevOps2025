pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'Staging-01', url: 'https://github.com/<your-username>/<your-repo>.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Building the application...'
                sh 'echo Build step complete'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'echo All tests passed!'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh 'echo Deployment successful!'
            }
        }
    }
}
